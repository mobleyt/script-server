# Copy to .env and edit for this server.

# Address Caddy serves. Pick one:
#   :80                    plain HTTP on any hostname (local testing, or behind
#                          another TLS-terminating load balancer)
#   tools.example.edu      real public DNS name: Caddy obtains and renews a
#                          Let's Encrypt certificate automatically (needs ports
#                          80 and 443 reachable from the internet)
#   http://tools.example.edu   named host, HTTP only
SITE_ADDRESS=:80

# Host ports the proxy binds.
HTTP_PORT=80
HTTPS_PORT=443

# --- transcript-converter ---
TRANSCRIPTS_MAX_UPLOAD_MB=50
TRANSCRIPTS_WORKERS=2

# --- rev-converter ---
REV_MAX_UPLOAD_MB=50
REV_WORKERS=2

# --- aviary-uploader ---
# API key of the Aviary user the tool acts as, and the numeric organization ID.
# To find the ID:  curl -s -X POST -H "Authorization: <key>" \
#                    https://www.aviaryplatform.com/api/v1/auth/sign_in
AVIARY_API_KEY=
AVIARY_ORG_ID=
AVIARY_BASE_URL=https://www.aviaryplatform.com
AVIARY_DEFAULT_ACCESS=private
AVIARY_MULTI_VALUE_DELIMITER=|
AVIARY_MAX_UPLOAD_MB=10      # proxy/routes/aviary.caddy allows up to 12 MB
AVIARY_MAX_ROWS=500
AVIARY_WORKERS=2

# Login for /aviary/. Make the hash with:
#   docker compose run --rm --no-deps proxy caddy hash-password
# It prompts for the password twice (nothing shows as you type), then prints
# a line starting with $2a$. Paste that line between the single quotes below.
# Keep the quotes, or compose will treat the $ signs as variables. Then run
#   docker compose up -d proxy
# Until this is set, /aviary/ can't be opened.
AVIARY_AUTH_USER=aviary
AVIARY_AUTH_HASH=''
